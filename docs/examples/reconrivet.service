[Unit]
Description=ReconRivet application
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=reconrivet
Group=reconrivet
WorkingDirectory=/opt/reconrivet
Environment=RECONRIVET_JWT_KEY_DIR=/opt/reconrivet/keys
ExecStart=/opt/reconrivet/reconrivet -addr 127.0.0.1:8787 -proxy 127.0.0.1:8788
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=control-group
UMask=0002
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reconrivet

[Install]
WantedBy=multi-user.target
